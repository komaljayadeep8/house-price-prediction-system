{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/"
    },
    {
      "source": "/css/(.*)",
      "destination": "/css/"
    },
    {
      "source": "/js/(.*)",
      "destination": "/js/"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}